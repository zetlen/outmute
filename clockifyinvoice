#!/usr/bin/env python3
"""Turn a Clockify "Detailed report" CSV export into a nice-looking invoice.

Clockify's invoicing is a paid feature; this is the free version. Export a
Detailed report as CSV (Reports > Detailed > Export > Save as CSV), then:

    clockify-invoice report.csv                # writes <number>.html
    clockify-invoice report.csv --pdf          # also writes <number>.pdf (needs Chrome)
    clockify-invoice --init                    # write a starter config and exit

Sender, client, rates, tax, and payment notes live in a TOML config
(default: ~/.config/clockify-invoice/config.toml). Rates come from the CSV's
"Billable Rate" column when present, falling back to [rates] in the config.

Requires Python 3.11+ (tomllib). No third-party packages.
"""

import argparse
import csv
import html
import math
import os
import re
import shutil
import subprocess
import sys
import tomllib
from collections import defaultdict
from dataclasses import dataclass
from datetime import date, datetime, timedelta
from pathlib import Path

CONFIG_TEMPLATE = """\
# clockify-invoice configuration

[from]
name = "Your Name"
# One line per list item, rendered under your name. Address, email, phone...
lines = ["123 Example Street", "Springfield, ST 00000", "you@example.com"]

[to]
name = "Client, Inc."
lines = ["456 Client Avenue", "Métropole, ST 11111"]

[invoice]
number_prefix = "INV-"   # default number is <prefix><last date in CSV as YYYYMMDD>
net_days = 30            # due date = issue date + net_days
currency = "$"           # symbol used for all amounts
tax_percent = 0.0        # 0 disables the tax line
tax_label = "Tax"
round_up_minutes = 0     # e.g. 15 rounds each line item's hours up to the quarter hour
notes = "Thank you for your business. Please remit payment within %(net_days)s days."
accent = "#20509e"       # accent color for the invoice
paper = "letter"         # or "a4"

# Hourly rates by Clockify project name, used when the CSV has no billable
# rate (or a zero rate) for an entry. "default" covers everything else.
[rates]
default = 100.0
# "Some Project" = 125.0

# [pdf]
# chrome = "/path/to/chrome"  # only needed if --pdf can't find Chrome/Chromium
"""

CURRENCY_SYMBOLS = {
    "USD": "$", "EUR": "€", "GBP": "£", "CAD": "CA$", "AUD": "A$",
    "NZD": "NZ$", "INR": "₹", "JPY": "¥", "CHF": "CHF", "SEK": "kr",
}

DATE_FORMATS = ["%Y-%m-%d", "%m/%d/%Y", "%d/%m/%Y", "%d.%m.%Y", "%Y/%m/%d"]


@dataclass
class Entry:
    day: date
    project: str
    description: str
    hours: float
    rate: float  # 0 means "not in CSV, resolve from config"
    billable: bool


@dataclass
class Line:
    primary: str
    secondary: str
    hours: float
    rate: float
    first_day: date

    @property
    def amount(self):
        return self.hours * self.rate


def die(message):
    print(f"clockify-invoice: {message}", file=sys.stderr)
    sys.exit(1)


def warn(message):
    print(f"clockify-invoice: warning: {message}", file=sys.stderr)


def default_config_path():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return Path(base) / "clockify-invoice" / "config.toml"


def load_config(path):
    if not path.is_file():
        die(f"no config at {path} — run `clockify-invoice --init` to create one")
    with open(path, "rb") as f:
        return tomllib.load(f)


def find_column(fieldnames, *prefixes):
    for prefix in prefixes:
        for name in fieldnames:
            if name.strip().lower().startswith(prefix.lower()):
                return name
    return None


def pick_date_format(raw_dates):
    """Find a strptime format that parses every date string in the CSV."""
    for fmt in DATE_FORMATS:
        try:
            for raw in raw_dates:
                datetime.strptime(raw, fmt)
            return fmt
        except ValueError:
            continue
    die(f"unrecognized date format in CSV (e.g. {raw_dates[0]!r})")


def parse_number(raw):
    raw = re.sub(r"[^\d.,\-]", "", raw or "").strip()
    if not raw:
        return 0.0
    if "," in raw and "." not in raw:
        raw = raw.replace(",", ".")
    else:
        raw = raw.replace(",", "")
    try:
        return float(raw)
    except ValueError:
        return 0.0


def parse_duration(row, decimal_col, hms_col):
    if decimal_col and row.get(decimal_col, "").strip():
        return parse_number(row[decimal_col])
    raw = (row.get(hms_col) or "").strip()
    parts = raw.split(":")
    if len(parts) != 3:
        die(f"can't parse duration {raw!r}")
    h, m, s = (int(p) for p in parts)
    return h + m / 60 + s / 3600


def read_entries(csv_path):
    with open(csv_path, newline="", encoding="utf-8-sig") as f:
        reader = csv.DictReader(f)
        fields = reader.fieldnames or []
        rows = [row for row in reader if any((v or "").strip() for v in row.values())]

    date_col = find_column(fields, "Start Date", "Date")
    hms_col = find_column(fields, "Duration (h)")
    decimal_col = find_column(fields, "Duration (decimal)")
    if not date_col or not (hms_col or decimal_col):
        die(
            "this doesn't look like a Clockify Detailed report CSV "
            "(need a Start Date and a Duration column). In Clockify: "
            "Reports > Detailed > Export > Save as CSV."
        )
    if not rows:
        die("CSV has no time entries")

    project_col = find_column(fields, "Project")
    desc_col = find_column(fields, "Description")
    billable_col = find_column(fields, "Billable")
    rate_col = find_column(fields, "Billable Rate")

    currency = None
    if rate_col:
        match = re.search(r"\(([A-Z]{3})\)", rate_col)
        if match:
            currency = CURRENCY_SYMBOLS.get(match.group(1))

    fmt = pick_date_format([row[date_col].strip() for row in rows])
    entries = []
    for row in rows:
        entries.append(Entry(
            day=datetime.strptime(row[date_col].strip(), fmt).date(),
            project=(row.get(project_col) or "").strip() if project_col else "",
            description=(row.get(desc_col) or "").strip() if desc_col else "",
            hours=parse_duration(row, decimal_col, hms_col),
            rate=parse_number(row.get(rate_col, "")) if rate_col else 0.0,
            billable=(row.get(billable_col) or "yes").strip().lower() in ("yes", "true", "1")
            if billable_col else True,
        ))
    return entries, currency


def resolve_rates(entries, rates_config):
    missing = set()
    for entry in entries:
        if entry.rate > 0:
            continue
        configured = rates_config.get(entry.project, rates_config.get("default"))
        if configured is None:
            missing.add(entry.project or "(no project)")
            configured = 0.0
        entry.rate = float(configured)
    if missing:
        warn(
            "no rate for project(s): " + ", ".join(sorted(missing))
            + " — set them under [rates] in the config"
        )


def fmt_day(d):
    return d.strftime("%b %d, %Y").replace(" 0", " ")


def build_lines(entries, group_by):
    groups = defaultdict(list)
    for i, entry in enumerate(entries):
        if group_by == "description":
            key = (entry.project, entry.description, entry.rate)
        elif group_by == "project":
            key = (entry.project, entry.rate)
        elif group_by == "day":
            key = (entry.day, entry.project, entry.rate)
        else:  # entry
            key = i
        groups[key].append(entry)

    lines = []
    for bucket in groups.values():
        first = min(bucket, key=lambda e: e.day)
        hours = sum(e.hours for e in bucket)
        descriptions = list(dict.fromkeys(e.description for e in bucket if e.description))
        if group_by == "description":
            primary = first.description or "(no description)"
            secondary = first.project
        elif group_by == "project":
            primary = first.project or "(no project)"
            secondary = "; ".join(descriptions)
        elif group_by == "day":
            primary = f"{fmt_day(first.day)} — {first.project}" if first.project else fmt_day(first.day)
            secondary = "; ".join(descriptions)
        else:
            primary = first.description or "(no description)"
            secondary = " · ".join(p for p in (first.project, fmt_day(first.day)) if p)
        lines.append(Line(primary, secondary, hours, first.rate, first.day))

    lines.sort(key=lambda ln: (ln.first_day, ln.primary.lower()))
    return lines


def money(symbol, amount):
    sep = " " if len(symbol) > 1 else ""
    return f"{symbol}{sep}{amount:,.2f}"


def esc(text):
    return html.escape(str(text))


def render_html(config, lines, entries, meta):
    inv = config.get("invoice", {})
    accent = inv.get("accent", "#20509e")
    paper = "A4" if str(inv.get("paper", "letter")).lower() == "a4" else "letter"
    sym = meta["currency"]

    def party(section, fallback):
        info = config.get(section, {})
        name = esc(info.get("name", fallback))
        extra = "".join(f"<div>{esc(line)}</div>" for line in info.get("lines", []))
        return f'<div class="party-name">{name}</div>{extra}'

    rows_html = ""
    for line in lines:
        secondary = f'<div class="secondary">{esc(line.secondary)}</div>' if line.secondary else ""
        rows_html += f"""
        <tr>
            <td class="desc">{esc(line.primary)}{secondary}</td>
            <td class="num">{line.hours:,.2f}</td>
            <td class="num">{money(sym, line.rate)}</td>
            <td class="num">{money(sym, line.amount)}</td>
        </tr>"""

    totals_html = f"""
        <tr><td>Subtotal</td><td class="num">{money(sym, meta['subtotal'])}</td></tr>"""
    if meta["tax"] > 0:
        label = esc(inv.get("tax_label", "Tax"))
        totals_html += f"""
        <tr><td>{label} ({meta['tax_percent']:g}%)</td><td class="num">{money(sym, meta['tax'])}</td></tr>"""
    totals_html += f"""
        <tr class="grand"><td>Total Due</td><td class="num">{money(sym, meta['total'])}</td></tr>"""

    notes = inv.get("notes", "")
    try:
        notes = notes % {"net_days": inv.get("net_days", 30)}
    except (KeyError, TypeError, ValueError):
        pass
    notes_html = f'<div class="notes"><div class="label">Notes</div>{esc(notes)}</div>' if notes else ""

    appendix_html = ""
    if meta["appendix"]:
        detail_rows = "".join(
            f"""
        <tr>
            <td>{esc(fmt_day(e.day))}</td>
            <td>{esc(e.project)}</td>
            <td>{esc(e.description)}</td>
            <td class="num">{e.hours:,.2f}</td>
        </tr>"""
            for e in sorted(entries, key=lambda e: e.day)
        )
        appendix_html = f"""
    <section class="appendix">
        <div class="label">Time Entry Detail</div>
        <table>
            <thead><tr><th>Date</th><th>Project</th><th>Description</th><th class="num">Hours</th></tr></thead>
            <tbody>{detail_rows}
            </tbody>
        </table>
    </section>"""

    return f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Invoice {esc(meta['number'])}</title>
<style>
:root {{ --accent: {accent}; --ink: #1a1d21; --muted: #6b7280; --rule: #e5e7eb; }}
* {{ box-sizing: border-box; margin: 0; padding: 0; }}
@page {{ size: {paper}; margin: 16mm; }}
html {{ background: #f3f4f6; }}
body {{
    font: 10.5pt/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
}}
.page {{
    background: #fff; max-width: 8.5in; margin: 2rem auto; padding: 0.9in;
    box-shadow: 0 2px 24px rgba(0,0,0,.10);
}}
@media print {{
    html {{ background: #fff; }}
    .page {{ max-width: none; margin: 0; padding: 0; box-shadow: none; }}
}}
header {{ display: flex; justify-content: space-between; align-items: flex-start; }}
.party-name {{ font-size: 14pt; font-weight: 650; }}
.from {{ color: var(--muted); }} .from .party-name {{ color: var(--ink); }}
h1 {{
    font-size: 24pt; font-weight: 300; letter-spacing: .18em;
    text-transform: uppercase; color: var(--accent); text-align: right;
}}
.meta {{ margin-top: .75rem; text-align: right; color: var(--muted); }}
.meta b {{ color: var(--ink); font-weight: 600; margin-left: .5em; }}
.billto {{ margin: 2.2rem 0 0; }}
.label {{
    font-size: 8pt; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
    color: var(--accent); margin-bottom: .35rem;
}}
table {{ width: 100%; border-collapse: collapse; margin-top: 1.6rem; }}
th {{
    font-size: 8pt; letter-spacing: .12em; text-transform: uppercase; color: var(--muted);
    text-align: left; padding: 0 .6rem .45rem; border-bottom: 2px solid var(--ink);
}}
td {{ padding: .55rem .6rem; border-bottom: 1px solid var(--rule); vertical-align: top; }}
tr {{ break-inside: avoid; }}
.num, th.num {{ text-align: right; white-space: nowrap; }}
.desc {{ width: 55%; }}
.secondary {{ color: var(--muted); font-size: 9pt; }}
.totals {{ display: flex; justify-content: flex-end; }}
.totals table {{ width: 45%; margin-top: .4rem; }}
.totals td {{ border-bottom: none; padding: .3rem .6rem; }}
.totals td:first-child {{ color: var(--muted); }}
.totals .grand td {{
    border-top: 2px solid var(--ink); font-weight: 700; font-size: 12pt;
    color: var(--accent); padding-top: .55rem;
}}
.notes {{ margin-top: 2.2rem; color: var(--muted); max-width: 60%; }}
.appendix {{ break-before: page; margin-top: 2.2rem; }}
.appendix td, .appendix th {{ font-size: 9pt; }}
footer {{
    margin-top: 3rem; padding-top: .8rem; border-top: 1px solid var(--rule);
    color: var(--muted); font-size: 8.5pt; display: flex; justify-content: space-between;
}}
</style>
</head>
<body>
<div class="page">
    <header>
        <div class="from">{party('from', 'Your Name')}</div>
        <div>
            <h1>Invoice</h1>
            <div class="meta">
                <div>Invoice No.<b>{esc(meta['number'])}</b></div>
                <div>Issue Date<b>{esc(fmt_day(meta['issued']))}</b></div>
                <div>Due Date<b>{esc(fmt_day(meta['due']))}</b></div>
                <div>Period<b>{esc(fmt_day(meta['start']))} – {esc(fmt_day(meta['end']))}</b></div>
            </div>
        </div>
    </header>
    <section class="billto">
        <div class="label">Bill To</div>
        {party('to', 'Client')}
    </section>
    <table>
        <thead>
            <tr><th class="desc">Description</th><th class="num">Hours</th><th class="num">Rate</th><th class="num">Amount</th></tr>
        </thead>
        <tbody>{rows_html}
        </tbody>
    </table>
    <div class="totals">
        <table>{totals_html}
        </table>
    </div>
    {notes_html}
    {appendix_html}
    <footer>
        <div>Invoice {esc(meta['number'])}</div>
        <div>{money(sym, meta['total'])} due {esc(fmt_day(meta['due']))}</div>
    </footer>
</div>
</body>
</html>
"""


def find_chrome(config):
    candidates = [
        config.get("pdf", {}).get("chrome"),
        os.environ.get("CLOCKIFY_INVOICE_CHROME"),
        "google-chrome", "google-chrome-stable", "chromium", "chromium-browser",
        "chrome", "brave-browser", "microsoft-edge",
        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
        "/Applications/Chromium.app/Contents/MacOS/Chromium",
        "/opt/pw-browsers/chromium",
    ]
    for candidate in candidates:
        if not candidate:
            continue
        found = shutil.which(candidate) or (candidate if os.path.isfile(candidate) else None)
        if found:
            return found
    return None


def html_to_pdf(chrome, html_path, pdf_path):
    base = [chrome, "--disable-gpu", "--no-pdf-header-footer",
            f"--print-to-pdf={pdf_path}", html_path.as_uri()]
    if hasattr(os, "geteuid") and os.geteuid() == 0:
        base.insert(1, "--no-sandbox")
    for headless in ("--headless=new", "--headless"):
        result = subprocess.run(
            [base[0], headless, *base[1:]], capture_output=True, text=True, timeout=60
        )
        if result.returncode == 0 and pdf_path.is_file():
            return True
    warn(f"chrome failed to render PDF: {result.stderr.strip().splitlines()[-1:]}")
    return False


def main():
    parser = argparse.ArgumentParser(
        prog="clockify-invoice",
        description="Generate an invoice from a Clockify Detailed report CSV.",
    )
    parser.add_argument("csv", nargs="?", help="Clockify Detailed report CSV export")
    parser.add_argument("-c", "--config", type=Path, default=default_config_path(),
                        help="config file (default: %(default)s)")
    parser.add_argument("-o", "--output", type=Path, help="output HTML path (default: <number>.html)")
    parser.add_argument("-n", "--number", help="invoice number (default: prefix + last entry date)")
    parser.add_argument("-g", "--group", choices=["description", "project", "day", "entry"],
                        default="description", help="how to group entries into line items (default: %(default)s)")
    parser.add_argument("--all", action="store_true", help="include entries marked non-billable")
    parser.add_argument("--appendix", action="store_true",
                        help="append a per-entry detail table on its own page")
    parser.add_argument("--pdf", action="store_true", help="also render a PDF via Chrome/Chromium")
    parser.add_argument("--open", action="store_true", help="open the result when done")
    parser.add_argument("--init", action="store_true", help="write a starter config and exit")
    args = parser.parse_args()

    if args.init:
        if args.config.exists():
            die(f"{args.config} already exists; not overwriting")
        args.config.parent.mkdir(parents=True, exist_ok=True)
        args.config.write_text(CONFIG_TEMPLATE)
        print(f"Wrote {args.config} — edit it, then run: clockify-invoice report.csv")
        return

    if not args.csv:
        parser.error("csv file is required (or use --init)")

    config = load_config(args.config)
    inv = config.get("invoice", {})

    entries, csv_currency = read_entries(args.csv)
    if not args.all:
        skipped = [e for e in entries if not e.billable]
        entries = [e for e in entries if e.billable]
        if skipped:
            warn(f"skipped {len(skipped)} non-billable entr{'y' if len(skipped) == 1 else 'ies'} (use --all to include)")
        if not entries:
            die("no billable entries in CSV (use --all to include non-billable)")

    resolve_rates(entries, config.get("rates", {}))
    lines = build_lines(entries, args.group)

    round_minutes = int(inv.get("round_up_minutes", 0))
    if round_minutes > 0:
        increment = round_minutes / 60
        for line in lines:
            line.hours = math.ceil(line.hours / increment - 1e-9) * increment

    subtotal = sum(line.amount for line in lines)
    tax_percent = float(inv.get("tax_percent", 0))
    tax = subtotal * tax_percent / 100
    start, end = min(e.day for e in entries), max(e.day for e in entries)
    issued = date.today()
    number = args.number or f"{inv.get('number_prefix', 'INV-')}{end.strftime('%Y%m%d')}"

    meta = {
        "number": number,
        "issued": issued,
        "due": issued + timedelta(days=int(inv.get("net_days", 30))),
        "start": start,
        "end": end,
        "subtotal": subtotal,
        "tax_percent": tax_percent,
        "tax": tax,
        "total": subtotal + tax,
        "currency": inv.get("currency") or csv_currency or "$",
        "appendix": args.appendix,
    }

    out_html = args.output or Path(f"{re.sub(r'[^A-Za-z0-9._-]', '_', number)}.html")
    out_html.write_text(render_html(config, lines, entries, meta))
    total_hours = sum(line.hours for line in lines)
    print(f"{out_html}: {len(lines)} line item(s), {total_hours:,.2f} hours, "
          f"{money(meta['currency'], meta['total'])} due {fmt_day(meta['due'])}")

    opened_target = out_html
    if args.pdf:
        chrome = find_chrome(config)
        if not chrome:
            warn("no Chrome/Chromium found for --pdf; set [pdf].chrome in the config. "
                 "The HTML also prints cleanly from any browser.")
        else:
            out_pdf = out_html.with_suffix(".pdf")
            if html_to_pdf(chrome, out_html.resolve(), out_pdf.resolve()):
                print(f"{out_pdf}")
                opened_target = out_pdf

    if args.open:
        opener = "open" if sys.platform == "darwin" else "xdg-open"
        subprocess.run([opener, str(opened_target)], check=False)


if __name__ == "__main__":
    main()

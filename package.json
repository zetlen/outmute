{
  "name": "outmute",
  "version": "2.0.0",
  "description": "Turn time-tracking exports (Clockify, for now) into PDF invoices — in the browser or from the command line. In voice ⇒ out mute.",
  "license": "MIT",
  "bin": {
    "outmute": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "cli": "bun run src/cli.ts",
    "web": "bun ./src/web/index.html",
    "build:web": "bun build ./src/web/index.html --outdir=dist --minify --define OUTMUTE_VERSION=\\\"$npm_package_version\\\"",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint",
    "test": "bun test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^7",
    "wawoff2": "^2.0.1"
  }
}
